{
	email {$ACME_EMAIL}
}

*.{$CADDY_BASE_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	@arcane host arcane.{$CADDY_BASE_DOMAIN}
	handle @arcane {
		reverse_proxy arcane:3552
	}

	@uptime host uptime.{$CADDY_BASE_DOMAIN}
	# Uptime Kuma is on prdsrv3 (infra container on prx2), so it can report prdsrv2 down
	handle @uptime {
		reverse_proxy 10.69.20.115:3001
	}

	@metabase host metabase.{$CADDY_BASE_DOMAIN}
	handle @metabase {
		reverse_proxy metabase:3000
	}

	@paperless host paperless.{$CADDY_BASE_DOMAIN}
	handle @paperless {
		reverse_proxy paperless-webserver:8000
	}

	@n8n host n8n.{$CADDY_BASE_DOMAIN}
	handle @n8n {
		reverse_proxy n8n:5678
	}

	@logs host logs.{$CADDY_BASE_DOMAIN}
	handle @logs {
		reverse_proxy dozzle:8080
	}

	# Homarr, the dashboard (home. since Homepage was retired 2026-09-30; dash. kept)
	@dash host home.{$CADDY_BASE_DOMAIN} dash.{$CADDY_BASE_DOMAIN}
	handle @dash {
		reverse_proxy homarr:7575
	}

	# Pi-hole's page is on prdsrv2, published for this Caddy on 10.69.20.114:8081
	@pihole host pihole.{$CADDY_BASE_DOMAIN}
	handle @pihole {
		reverse_proxy 10.69.20.114:8081
	}

	# Beszel hub (prdsrv3): the page, and the agents' WebSocket
	@beszel host beszel.{$CADDY_BASE_DOMAIN}
	handle @beszel {
		reverse_proxy 10.69.20.115:8090
	}

	# Second Pi-hole (prdsrv3), kept in step by nebula-sync
	@pihole2 host pihole2.{$CADDY_BASE_DOMAIN}
	handle @pihole2 {
		reverse_proxy 10.69.20.115:8081
	}

	@prx1 host prx1.{$CADDY_BASE_DOMAIN}
	handle @prx1 {
		reverse_proxy https://10.69.20.130:8006 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@prx2 host prx2.{$CADDY_BASE_DOMAIN}
	handle @prx2 {
		reverse_proxy https://10.69.20.131:8006 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle {
		respond "Not found" 404
	}
}
