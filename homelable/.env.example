# Values are in 1Password, item homelab-homelable (vault Development). Rebuild .env with:
#   op inject -i .env.example -o .env
# The login is the item's username and password; the backend holds only the bcrypt hash.
DOMAIN=op://Development/homelab-shared/env/DOMAIN
SECRET_KEY=op://Development/homelab-homelable/env/SECRET_KEY
AUTH_USERNAME=op://Development/homelab-homelable/username
AUTH_PASSWORD_HASH='op://Development/homelab-homelable/env/AUTH_PASSWORD_HASH'
