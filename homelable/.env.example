# Values are in 1Password, item homelab-homelable (vault Development). Rebuild .env with:
#   op inject -i .env.example -o .env
# The login is the item's username and password; the backend holds only the bcrypt hash.
DOMAIN=op://Development/homelab-shared/env/DOMAIN
SECRET_KEY=op://Development/homelab-homelable/env/SECRET_KEY
AUTH_USERNAME=op://Development/homelab-homelable/username
AUTH_PASSWORD_HASH='op://Development/homelab-homelable/env/AUTH_PASSWORD_HASH'
# Proxmox import: token homelable@pve!map (role PVEAuditor) on each host
PROXMOX_ENDPOINTS='[{"host":"10.69.20.130","token_id":"homelable@pve!map","token_secret":"{{ op://Development/homelab-homelable/env/PROXMOX_PRX1_TOKEN_SECRET }}","verify_tls":false},{"host":"10.69.20.131","token_id":"homelable@pve!map","token_secret":"{{ op://Development/homelab-homelable/env/PROXMOX_PRX2_TOKEN_SECRET }}","verify_tls":false}]'
# UniFi import: the lab's shared UniFi API key
UNIFI_API_KEY=op://Development/homelab-unifi-api/credential
