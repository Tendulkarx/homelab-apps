# Values are in 1Password, item homelab-paperless (vault Development). Rebuild .env with:
#   op inject -i .env.example -o .env
PAPERLESS_DB_PASSWORD=op://Development/homelab-paperless/env/PAPERLESS_DB_PASSWORD
PAPERLESS_SECRET_KEY=op://Development/homelab-paperless/env/PAPERLESS_SECRET_KEY
# Base domain for the app addresses (1Password item homelab-shared)
DOMAIN=op://Development/homelab-shared/env/DOMAIN
