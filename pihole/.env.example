# Values are in 1Password, item prdsrv2-pihole (vault Development). Rebuild .env with:
#   op inject -i .env.example -o .env
PIHOLE_WEBPASSWORD=op://Development/prdsrv2-pihole/env/PIHOLE_WEBPASSWORD
# Address DNS answers on: 10.69.20.114 on prdsrv2 (primary), 10.69.20.115 on prdsrv3
PIHOLE_BIND_IP=10.69.20.114
# prdsrv2 only: web page published for Caddy (on prdsrv1)
PIHOLE_WEB_BIND=10.69.20.114
