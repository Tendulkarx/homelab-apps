# Values are in 1Password, item homelab-pihole (vault Development). Rebuild .env with:
#   op inject -i .env.example -o .env
PIHOLE_WEBPASSWORD=op://Development/homelab-pihole/env/PIHOLE_WEBPASSWORD
# Address DNS answers on: 10.69.20.114 on prdsrv2 (primary), 10.69.20.115 on prdsrv3
PIHOLE_BIND_IP=10.69.20.114
# Web page published for Caddy (on prdsrv1): .114 on prdsrv2, .115 on prdsrv3
PIHOLE_WEB_BIND=10.69.20.114
# Its address: pihole.<DOMAIN> on prdsrv2, pihole2.<DOMAIN> on prdsrv3 (change the first label there)
PIHOLE_WEB_DOMAIN=pihole.{{ op://Development/homelab-shared/env/DOMAIN }}
