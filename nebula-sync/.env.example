# Both Pi-holes share the password in 1Password item homelab-pihole. Rebuild .env with:
#   op inject -i .env.example -o .env
# Primary through Caddy on prdsrv2; replica by container name on prdsrv3's own network.
PRIMARY=https://pihole.{{ op://Development/homelab-shared/env/DOMAIN }}|{{ op://Development/homelab-pihole/env/PIHOLE_WEBPASSWORD }}
REPLICAS=http://pihole|{{ op://Development/homelab-pihole/env/PIHOLE_WEBPASSWORD }}
