# Both Pi-holes share the password in 1Password item prdsrv2-pihole. Rebuild .env with:
#   op inject -i .env.example -o .env
# Primary through Caddy on prdsrv2; replica by container name on prdsrv3's own network.
PRIMARY=https://pihole.example.com|{{ op://Development/prdsrv2-pihole/env/PIHOLE_WEBPASSWORD }}
REPLICAS=http://pihole|{{ op://Development/prdsrv2-pihole/env/PIHOLE_WEBPASSWORD }}
