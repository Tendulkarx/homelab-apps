# Values are in 1Password, item homelab-n8n (vault Development). Rebuild .env with:
#   op inject -i .env.example -o .env
N8N_USER=op://Development/homelab-n8n/env/N8N_USER
N8N_PASSWORD=op://Development/homelab-n8n/env/N8N_PASSWORD
# Base domain for the app addresses (1Password item homelab-shared)
DOMAIN=op://Development/homelab-shared/env/DOMAIN
