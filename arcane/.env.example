# Values are in 1Password, item homelab-arcane (vault Development). Rebuild .env with:
#   op inject -i .env.example -o .env
ARCANE_APP_URL=op://Development/homelab-arcane/env/ARCANE_APP_URL
PUID=op://Development/homelab-arcane/env/PUID
PGID=op://Development/homelab-arcane/env/PGID
ARCANE_ENCRYPTION_KEY=op://Development/homelab-arcane/env/ARCANE_ENCRYPTION_KEY
ARCANE_PROJECTS_DIRECTORY=op://Development/homelab-arcane/env/ARCANE_PROJECTS_DIRECTORY
