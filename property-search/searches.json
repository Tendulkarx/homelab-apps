            "propertyTypes": [
              "detached",
              "semi-detached",
              "terraced"
            ],
            "includeSSTC": false,
            "mustHave": [
              "parking"
            ],
            "dontShow": [
              "retirement",
              "sharedOwnership"
            ],
            "channel": "BUY"
          },
          "tracking": {
            "google_sheet": {
              "enabled": "${GOOGLE_SHEET_ENABLED:-true}",
              "spreadsheet_id": "${GOOGLE_SHEET_ID:-}",
              "sheet_name": "${GOOGLE_SHEET_NAME:-House Hunting}",
              "worksheet_name": "${GOOGLE_WORKSHEET_NAME:-DB}"
            },
            "database": {
              "enabled": "${DATABASE_ENABLED:-false}"
            },
            "email": {
              "enabled": true,
              "subject": "New Property Listings",
              "always_send": true,
              "sort": "area",
              "area_descending": true
            }
          }
