# Values are in 1Password, item prdsrv2-property-search (vault Development). Rebuild .env with:
#   op inject -i .env.example -o .env && chmod 600 .env
# A read-only service account for vault property-search-prod; the app's own secrets live there.
OP_SERVICE_ACCOUNT_TOKEN=op://Development/prdsrv2-property-search/env/OP_SERVICE_ACCOUNT_TOKEN
