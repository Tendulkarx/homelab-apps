# Values are in 1Password, vault Development: items homelab-property-search and
# homelab-property-search-google-sheets. Build .env from the Mac (escapes the multi-line JSON
# and any $ or quotes for Compose; nothing is printed):
#   python3 build-env.py | ssh prdsrv2 'umask 077; cat > /opt/docker/property-search/.env'
EMAIL_RECIPIENT=op://Development/homelab-property-search/EMAIL_RECIPIENT
EMAIL_FROM=op://Development/homelab-property-search/EMAIL_FROM
EMAIL_USERNAME=op://Development/homelab-property-search/EMAIL_USERNAME
EMAIL_PASSWORD=op://Development/homelab-property-search/EMAIL_PASSWORD
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
GOOGLE_SHEET_ENABLED=op://Development/homelab-property-search/GOOGLE_SHEET_ENABLED
GOOGLE_SHEET_ID=op://Development/homelab-property-search/GOOGLE_SHEET_ID
GOOGLE_SHEETS_CREDENTIALS=op://Development/homelab-property-search-google-sheets/credentials
DATABASE_ENABLED=op://Development/homelab-property-search/DATABASE_ENABLED
DATABASE_URL=op://Development/homelab-property-search/DATABASE_URL
HEARTBEAT_URL=op://Development/homelab-property-search/HEARTBEAT_URL
